# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of reverse proxies in front of the app (needed for correct client IPs
# in rate limiting). Use 0 when running without a proxy, 1 behind Nginx/Caddy.
TRUST_PROXY=0

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://presence:change-me@localhost:5432/presence_dev?schema=public
# Used by the automated backend and end-to-end tests (data is wiped on each run).
TEST_DATABASE_URL=postgresql://presence:change-me@localhost:5432/presence_test?schema=public

# ─── Public URLs ────────────────────────────────────────────────────────────
# Permanent public address of the site. Used for canonical URLs, social previews
# and as the base of the digital card URL (<PUBLIC_SITE_URL>/card).
PUBLIC_SITE_URL=http://localhost:5180
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5180
# Directory with the built frontend. When it exists, the API also serves the
# website (single-origin production deployment). Leave empty to disable.
FRONTEND_DIST_DIR=../frontend/dist

# ─── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
CONTACT_RATE_LIMIT_MAX=5
# Submissions sent faster than this after the form was rendered are treated as spam.
CONTACT_MIN_FILL_MS=3000

# ─── Email notifications (optional) ─────────────────────────────────────────
# When SMTP_HOST is empty, submissions are still stored but no email is sent.
# Works with any SMTP provider (Resend: host smtp.resend.com, user "resend",
# password = API key; Gmail: an app password; Mailgun, SES, Postmark, ...).
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown in notification emails, e.g. "Website <no-reply@yourdomain.com>"
MAIL_FROM=
# Who receives notifications. Defaults to the profile email when empty.
CONTACT_RECIPIENT=
