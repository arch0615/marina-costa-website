# Permanent public URL of the website (no trailing slash). Used for the QR code,
# canonical URLs, social previews, robots.txt and sitemap.xml. Set it to the
# production domain when building for production, e.g. https://www.example.com
VITE_SITE_URL=http://localhost:5180

# Default title/description baked into index.html (replaced per route by the API
# when it serves the site). Keep them in sync with the seeded profile.
VITE_SITE_TITLE=Marina Costa — Brand & Digital Product Designer
VITE_SITE_DESCRIPTION=Independent brand and digital product designer helping growing companies build clear brands and digital products.

# Base URL of the API when it is hosted on a different origin, e.g.
# https://api.example.com. Leave empty when the API serves the site (recommended)
# or during development (Vite proxies /api to the backend).
VITE_API_URL=

# Development only: where the Vite dev server proxies /api requests.
VITE_DEV_API_PROXY=http://localhost:4000
